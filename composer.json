{
  "name": "gemacode/module-govp",
  "description": "Open source GOVP Exchange connector for Magento Open Source and Adobe Commerce.",
  "type": "magento2-module",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2 || ^8.3 || ^8.4",
    "magento/framework": "^103.0",
    "magento/module-sales": "^103.0",
    "magento/module-config": "^101.2"
  },
  "autoload": {
    "files": ["registration.php"],
    "psr-4": {"Gemacode\\Govp\\": ""}
  },
  "archive": {
    "exclude": [
      "/.github",
      "/tests",
      "/govp-for-magento-*.zip",
      "/private",
      "/CONTRIBUTING.md",
      "/NATIVE_ACCEPTANCE.md"
    ]
  }
}
