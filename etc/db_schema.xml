<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
  <table name="gemacode_govp_shipment" resource="default" engine="innodb" comment="GOVP Shipment State">
    <column xsi:type="bigint" name="shipment_id" unsigned="true" nullable="false" comment="Shipment ID"/>
    <column xsi:type="varchar" name="status" nullable="false" length="24" default="queued" comment="Status"/>
    <column xsi:type="varchar" name="govp_code" nullable="true" length="128" comment="GOVP Code"/>
    <column xsi:type="text" name="verify_url" nullable="true" comment="Verification URL"/>
    <column xsi:type="text" name="last_error" nullable="true" comment="Last Error"/>
    <column xsi:type="int" name="attempts" unsigned="true" nullable="false" default="0" comment="Attempts"/>
    <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true" comment="Updated At"/>
    <constraint xsi:type="primary" referenceId="PRIMARY"><column name="shipment_id"/></constraint>
    <constraint xsi:type="foreign" referenceId="GEMACODE_GOVP_SHIPMENT_ID_SALES_SHIPMENT_ENTITY_ID" table="gemacode_govp_shipment" column="shipment_id" referenceTable="sales_shipment" referenceColumn="entity_id" onDelete="CASCADE"/>
    <index referenceId="GEMACODE_GOVP_SHIPMENT_STATUS" indexType="btree"><column name="status"/></index>
  </table>
</schema>
