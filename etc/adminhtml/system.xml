<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
  <system>
    <section id="govp" translate="label" type="text" sortOrder="950" showInDefault="1" showInWebsite="1" showInStore="0">
      <label>GOVP Exchange</label><tab>sales</tab><resource>Gemacode_Govp::config</resource>
      <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
        <label>Connection</label>
        <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0"><label>Issue GOVP for shipments</label><source_model>Magento\Config\Model\Config\Source\Yesno</source_model></field>
        <field id="exchange_url" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0"><label>Exchange API URL</label><validate>required-entry validate-url</validate></field>
        <field id="token" translate="label" type="obscure" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="0"><label>Connector token</label><backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model></field>
        <field id="issuer_name" translate="label" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0"><label>Issuer name</label><validate>required-entry</validate></field>
        <field id="validity_days" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0"><label>Validity days</label><validate>required-entry validate-digits validate-greater-than-zero</validate></field>
      </group>
    </section>
  </system>
</config>
